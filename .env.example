# Keenetic API
ROUTER_IP=192.168.1.1          # IP вашего роутера
ROUTER_PORT=80                 # Порт HTTP (обычно 80)
ROUTER_USE_HTTPS=false         # true если используете HTTPS
ROUTER_USER=admin              # Пользователь с правами на API
ROUTER_PASSWORD=your_password  # Пароль
ROUTER_INTERFACE=Bridge2       # Интерфейс для управления MAC

# MQTT
MQTT_BROKER=192.168.1.140      # IP MQTT-брокера
MQTT_PORT=1883                 # Порт MQTT
MQTT_USE_TLS=false
MQTT_USER=gateway              # Если требуется аутентификация
MQTT_PASSWORD=mqtt_pass
MQTT_TOPIC_COMMAND=keenetic-gateway/command
MQTT_TOPIC_RESPONSE=keenetic-gateway/response
MQTT_TOPIC_HEALTH=keenetic-gateway/health   # Опционально

# Секретный ключ для проверки команд
SECRET_KEY=your_very_strong_secret_key

# Логирование и healthcheck
LOG_LEVEL=INFO
HEALTH_INTERVAL=60
HEALTH_SERVER_PORT=8080